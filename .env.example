# Скопируй в .env и заполни то, что нужно. Всё опционально:
# без единой заполненной строки проект работает на extractive-движке
# и печатает дайджест в консоль.

# --- Доставка (бесплатно) ---------------------------------------------
# Токен бота: @BotFather -> /newbot
TG_BOT_TOKEN=
# Твой chat_id: напиши @userinfobot
TG_CHAT_ID=

# --- Движок суммаризации ----------------------------------------------
# auto (по умолчанию) | extractive | ollama | groq | gemini | openrouter
SUMMARIZER_BACKEND=auto

# Локальная модель — бесплатно и офлайн. ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Groq free tier — console.groq.com, карта не нужна
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio free tier — aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter — модели со слагом :free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Платный вариант. Никогда не выбирается автоматически.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
